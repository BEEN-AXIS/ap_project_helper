# Copy to .env (cp .env.example .env). Real environment variables win over this file.

# dev | test | prod. test enables the fake judge ("# VERDICT: AC" comments).
# prod refuses the default JWT secret, the subprocess judge, the fake judge and DATABASE_URL=memory.
ENV=dev

# PostgreSQL, used through Prisma: postgresql://user:pass@localhost:5432/algoarena
# Create the tables with `make migrate` (npx prisma migrate deploy).
# DATABASE_URL=memory runs on a throwaway in-memory database, seeded on start (demo only).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/algoarena

# At least 32 random characters in prod: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only

# Comma-separated browser origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# auto | docker | subprocess | judge0 | fake (fake only with ENV=test).
# auto = Docker when the daemon and the algoarena-judge image are present, else the
# DEV SANDBOX subprocess runner (refused in prod).
JUDGE_BACKEND=auto
JUDGE_CONCURRENCY=4
JUDGE_IMAGE=algoarena-judge:latest
# Self-hosted Judge0 CE, only for JUDGE_BACKEND=judge0, e.g. http://localhost:2358
JUDGE0_URL=

# Overrides for shared/game-config.json (leave blank to use the file).
MATCH_MAX_MINUTES=
BOT_FALLBACK_SECONDS=
# Speeds up simulated bots; 0.02 makes a bot solve in seconds (handy for demos).
BOT_TIME_SCALE=

LOG_LEVEL=INFO
